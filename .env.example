# Application posture (safe defaults)
APP_ENV=development
TRADING_ENV=demo
TRADING_MODE=SIGNAL

# Live trading remains disabled unless all three production gates match.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_TRADING_CONFIRMATION_SECRET=

# Broker: use mock for local/CI; switch to mt5 only on the Windows execution node.
BROKER_TYPE=mock
CANONICAL_SYMBOL=XAUUSD
ENTRY_ORDER_TYPE=MARKET
MAX_TICK_AGE_SECONDS=30
MAXIMUM_SPREAD=0.50
MAXIMUM_SLIPPAGE=0.30
TRADE_SESSIONS=london,new_york
USE_CLOSED_CANDLES_ONLY=true
NEWS_FILTER_ENABLED=false
TP1_PARTIAL_CLOSE_ENABLED=false
TP1_CLOSE_FRACTION=0.50
BREAK_EVEN_ENABLED=false
BREAK_EVEN_TRIGGER_R=1.0
TRAILING_STOP_ENABLED=false
TRAILING_ATR_MULTIPLE=2.0
HEARTBEAT_INTERVAL_SECONDS=30
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
MT5_TERMINAL_PATH=

# Persistent application truth and coordination
DATABASE_URL=postgresql+psycopg://goldflow:change-me@localhost:5432/goldflow
REDIS_URL=redis://localhost:6379/0

# API security — replace JWT_SECRET before any shared deployment.
JWT_SECRET=development-only-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=goldflow
JWT_AUDIENCE=goldflow-api
ACCESS_TOKEN_MINUTES=30
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60

# Non-bypassable risk defaults
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_WEEKLY_LOSS=0.07
MAX_ACCOUNT_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=1
MAX_GOLD_POSITIONS=1
MINIMUM_RR=1.8
PREFERRED_RR=2.0

# Required evidence before production AUTO (does not guarantee future performance)
REQUIRE_DEMO_VALIDATION_FOR_LIVE=true
MINIMUM_DEMO_TRADES=100
MAXIMUM_DEMO_DRAWDOWN=0.10
MINIMUM_DEMO_PROFIT_FACTOR=1.2

# Notifications and error tracking
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
